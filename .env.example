PASSWORD=replace-with-a-strong-password
JUPYTER_TOKEN=replace-with-a-random-token
NODE_RED_CREDENTIAL_SECRET=replace-with-a-random-secret

# Git-versioned source bundled with CADE Light; or "git" / "host".
NODE_RED_FLOWS_SOURCE=bundled
NODE_RED_GIT_URL=
NODE_RED_GIT_REF=main
NODE_RED_FLOW_PATH=flows.json
# Default separate Docker volume; optionally ./state/node-red.
NODE_RED_STATE_STORAGE=node_red_state
# Only used by compose.node-red-host-flows.yaml:
NODE_RED_HOST_FLOWS_PATH=./flows
